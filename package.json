{
  "name": "gestao-ativos-ti-tucurui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "start": "node server/production.js",
    "start:api": "node server/index.js",
    "start:web": "vite preview --host 0.0.0.0 --port 4173",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "latest",
    "react": "latest",
    "pg": "^8.16.3",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}
