{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Abrir MVP Visual",
      "type": "shell",
      "windows": {
        "command": "cmd /c start \"\" \"${workspaceFolder}\\MVP_VISUAL.html\""
      },
      "linux": {
        "command": "xdg-open \"${workspaceFolder}/MVP_VISUAL.html\""
      },
      "osx": {
        "command": "open \"${workspaceFolder}/MVP_VISUAL.html\""
      },
      "problemMatcher": []
    },
    {
      "label": "Instalar dependências (sistema completo)",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Executar sistema completo",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
